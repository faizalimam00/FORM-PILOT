---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="This FormPilot page could not be found. Return to documentation or try the controlled form demo."
>
  <div class="page-heading">
    <h1>This page is missing.</h1>
    <p>The form-filling decisions are still yours. The URL might need a second look.</p>
  </div>
  <div class="row" style="margin-bottom:80px">
    <a class="button" href="/">
      Back to FormPilot
    </a>
    <a href="/docs/">Read the documentation</a>
  </div>
</Layout>
